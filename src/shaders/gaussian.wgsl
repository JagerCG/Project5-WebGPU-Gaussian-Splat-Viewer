struct CameraUniforms {
    view: mat4x4<f32>,
    view_inv: mat4x4<f32>,
    proj: mat4x4<f32>,
    proj_inv: mat4x4<f32>,
    viewport: vec2<f32>,
    focal: vec2<f32>
};

struct Gaussian {
    pos_opacity: array<u32, 2>,
    rot: array<u32, 2>,
    scale: array<u32, 2>
};

@group(0) @binding(0)
var<uniform> camera: CameraUniforms;

@group(1) @binding(0)
var<storage, read> gaussians: array<Gaussian>;

@group(1) @binding(1)
var<storage, read> splats: array<Splat>;

@group(1) @binding(2)
var<storage, read> sorted_indices: array<u32>;

struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    //TODO: information passed from vertex shader to fragment shader
    @location(0) color: vec3<f32>,
    @location(1) center_pixel: vec2<f32>,
    @location(2) conic: vec3<f32>,
    @location(3) opacity: f32,
};

struct Splat {
    //TODO: information defined in preprocess compute shader
    position: vec4<f32>,
    conic_opacity: vec4<f32>,
    quad_size: vec4<f32>,
    color: vec4<f32>,
};

@vertex
fn vs_main(
    @builtin(vertex_index) vertex_index: u32,
    @builtin(instance_index) instance_index: u32,
) -> VertexOutput {
    //TODO: reconstruct 2D quad based on information from splat, pass 
    var out: VertexOutput;

    // One instance follows the sorted back-to-front order.
    let splat_idx = sorted_indices[instance_index];
    let splat = splats[splat_idx];
    let clip_pos = splat.position;

    // Two triangles = one quad
    var corner = vec2<f32>(0.0);

    switch vertex_index {
        case 0u: {
            corner = vec2<f32>(-1.0, -1.0);
        }
        case 1u: {
            corner = vec2<f32>( 1.0, -1.0);
        }
        case 2u: {
            corner = vec2<f32>(-1.0,  1.0);
        }
        case 3u: {
            corner = vec2<f32>(-1.0,  1.0);
        }
        case 4u: {
            corner = vec2<f32>( 1.0, -1.0);
        }
        case 5u: {
            corner = vec2<f32>( 1.0,  1.0);
        }
        default: {
            corner = vec2<f32>(0.0);
        }
    }

    // Quad size generated by preprocess.
    let half_size = splat.quad_size.xy;

    // Multiplying by clip_pos.w makes the offset constant in NDC
    out.position = vec4<f32>(
        clip_pos.xy + corner * half_size * clip_pos.w,
        clip_pos.z,
        clip_pos.w
    );
    out.color = splat.color.xyz;

    let center_ndc = clip_pos.xy / clip_pos.w;

    out.center_pixel = vec2<f32>(
        (center_ndc.x * 0.5 + 0.5) * camera.viewport.x,
        (0.5 - center_ndc.y * 0.5) * camera.viewport.y
    );

    out.conic = splat.conic_opacity.xyz;
    out.opacity = splat.conic_opacity.w;

    return out;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    var d = in.position.xy - in.center_pixel;

    // Assignment requires the x-coordinate of the pixel offset to be reversed.
    d.x = -d.x;

    let A = in.conic.x;
    let B = in.conic.y;
    let C = in.conic.z;

    let power = -0.5 * (
        A * d.x * d.x +
        2.0 * B * d.x * d.y +
        C * d.y * d.y
    );

    // Outside the valid Gaussian region.
    if (power > 0.0) {
        discard;
    }

    let weight = exp(power);
    let alpha = min(0.99, in.opacity * weight);

    // Ignore fragments whose contribution is essentially invisible.
    if (alpha < (1.0 / 255.0)) {
        discard;
    }

    return vec4<f32>(in.color, alpha);
}